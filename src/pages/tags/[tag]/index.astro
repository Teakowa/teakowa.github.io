---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, tagSlug } from '../../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`标签 ${tag} 下的文章。`} cwd="~/writing">
  <section class="section" aria-labelledby="tag">
    <h2 id="tag">grep -l "{tag.toLowerCase()}" ~/writing/*</h2>
    <PostList posts={posts} />
  </section>
</Base>
